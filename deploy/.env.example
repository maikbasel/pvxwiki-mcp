# Copy to .env next to compose.yaml and edit. Never commit .env.

# Required. Comma-separated host names clients use to reach the server (the Host header).
# Local use: localhost. With the https profile, also list your PVXWIKI_DOMAIN here,
# because Caddy forwards the public host name.
PVXWIKI_ALLOWED_HOSTS=localhost

# Contact address for the wiki scraper's User-Agent (required once the scraper exists).
# Use the project's GitHub URL or your email.
PVXWIKI_CONTACT=

# Proxies whose X-Forwarded-For header is trusted, comma-separated IPs or CIDR ranges.
# Without Caddy: leave empty.
# With the https profile: 172.31.250.10/32 (Caddy's fixed address, nothing else).
# Never trust 172.31.250.0/24: Docker's gateway 172.31.250.1 carries outside traffic,
# so any client could fake its IP and get around the rate limit.
PVXWIKI_TRUSTED_PROXIES=

# Interface the plain-HTTP port 8080 is published on.
# 127.0.0.1 keeps it local (use this with Caddy); 0.0.0.0 serves it publicly without Caddy.
#PVXWIKI_PUBLISH_ADDR=127.0.0.1

# Public domain for automatic HTTPS (https profile only). Also add it to PVXWIKI_ALLOWED_HOSTS.
#PVXWIKI_DOMAIN=mcp.example.org

# Optional, defaults shown.
#PVXWIKI_DATA_DIR=/data
#PVXWIKI_LISTEN=0.0.0.0:8080
#PVXWIKI_LOG_FORMAT=json          # json or pretty
#RUST_LOG=info,rmcp=warn
#PVXWIKI_IMAGE=ghcr.io/maikbasel/pvxwiki-mcp:latest

# Admin page (port 8081). It has no login of its own: keep it on loopback, or put a login in front.
PVXWIKI_ADMIN_PUBLISH_ADDR=127.0.0.1
# Bundled Caddy (https profile): sites to serve
PVXWIKI_CADDY_MCP=on
PVXWIKI_CADDY_ADMIN=off
# Only with PVXWIKI_CADDY_ADMIN=on. Also list the domain in PVXWIKI_ALLOWED_HOSTS.
PVXWIKI_ADMIN_DOMAIN=
PVXWIKI_ADMIN_USER=
# From: docker run --rm caddy:2.10 caddy hash-password. Keep the single quotes ($ signs).
PVXWIKI_ADMIN_PASSWORD_HASH=''
