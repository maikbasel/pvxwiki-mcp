    sections: [
        Section {
            heading: None,
            level: 0,
            wikitext: "{{Real-Vetting|status=provisional|rating=great|farming|PvE team|hero}}\n{{TOC|pos=r}}\n\nThis build uses a Perma Tank and a Life Barrier Bonder to tank and kill [[gww:Margonite|Margonites]] in the [[gww:City_of_Torc%27qua|City of Torc'qua]] in normal or hard mode through the use of visage spells and the Anur Tuk's [[gww:Famine|Famine]] spirits.  This can be done with either another player, or using a hero bonder.\n\n",
            text: "provisional great farming PvE team hero r This build uses a Perma Tank and a Life Barrier Bonder to tank and kill Margonites in the City of Torc'qua in normal or hard mode through the use of visage spells and the Anur Tuk's Famine spirits. This can be done with either another player, or using a hero bonder.",
        },
        Section {
            heading: Some(
                "Perma Tank",
            ),
            level: 2,
            wikitext: "== Perma Tank ==\n<pvxbig>\n[build prof=A/Me Shadow=12+1+3 Illusion=12 Deadly_Arts=3][Deadly Paradox][Shadow Form][Shroud of Distress][Great Dwarf Armor][\"I am unstoppable!\"][Ancestor's Visage][Sympathetic Visage][Death's Charge][/build]\n\n{{Variantbar|prof=Me|name=Me/A Mesmer Tank|position=1|template=[build prof=Me/A Shadow_Arts=12 Illusion_Magic=8 Fast_Casting=10][Deadly Paradox][Shadow Form][Shroud of Distress][Way of the Master][Way of Perfection][\"I Am Unstoppable!\"][Ancestor's Visage][Sympathetic Visage][/build]}}\n\n{{Variantbar|prof=E|name=E/Me Elementalist Tank|position=1|template=[build prof=E/Me Earth_Magic=12+1+3 Illusion_Magic=8 Energy_Storage=10 air_magic=2][Glyph of Swiftness][Obsidian Flesh][Stoneflesh Aura][Elemental Lord][Aura of Restoration][\"I Am Unstoppable!\"][Ancestor's Visage][Sympathetic Visage][/build]}}\n</pvxbig>\n\n",
            text: "Perma Tank [build prof=A/Me Shadow=12+1+3 Illusion=12 Deadly_Arts=3][Deadly Paradox][Shadow Form][Shroud of Distress][Great Dwarf Armor][\"I am unstoppable!\"][Ancestor's Visage][Sympathetic Visage][Death's Charge][/build] Me Me/A Mesmer Tank 1 [build prof=Me/A Shadow_Arts=12 Illusion_Magic=8 Fast_Casting=10][Deadly Paradox][Shadow Form][Shroud of Distress][Way of the Master][Way of Perfection][\"I Am Unstoppable!\"][Ancestor's Visage][Sympathetic Visage][/build] E E/Me Elementalist Tank 1 [build prof=E/Me Earth_Magic=12+1+3 Illusion_Magic=8 Energy_Storage=10 air_magic=2][Glyph of Swiftness][Obsidian Flesh][Stoneflesh Aura][Elemental Lord][Aura of Restoration][\"I Am Unstoppable!\"][Ancestor's Visage][Sympathetic Visage][/build]",
        },
        Section {
            heading: Some(
                "Equipment",
            ),
            level: 3,
            wikitext: "=== Equipment ===\n* Full Blessed Armor\n* Spear/Sword/Axe of Enchanting with +5 energy\n* Shield of Fortitude with +10 Vs Demons - such as the [[gww:Aegis_of_Aaaaarrrrrrggghhh|Aegis of Aaaaarrrrrrggghhh]] or [[gww:Aegis_of_Terror|Aegis of Terror]].\n* Enchanting staff of enchanting.  Preferably illusion for wanding down survivors.\n\n",
            text: "Equipment Full Blessed Armor Spear/Sword/Axe of Enchanting with +5 energy Shield of Fortitude with +10 Vs Demons - such as the Aegis of Aaaaarrrrrrggghhh or Aegis of Terror. Enchanting staff of enchanting. Preferably illusion for wanding down survivors.",
        },
        Section {
            heading: Some(
                "Usage",
            ),
            level: 3,
            wikitext: "=== Usage ===\n* Maintain all enchantments (except for the Visage skills) and \"I am unstoppable!\".\n* Group casters and paragons in a tight ball along the wall.\n* Drag melee to the ball and start maintaining your visages.  Only have one active at a time otherwise the enemies might break.\n* Pick up drops\n\n",
            text: "Usage Maintain all enchantments (except for the Visage skills) and \"I am unstoppable!\". Group casters and paragons in a tight ball along the wall. Drag melee to the ball and start maintaining your visages. Only have one active at a time otherwise the enemies might break. Pick up drops",
        },
        Section {
            heading: Some(
                "Life Barrier Bonder (Hero or Player)",
            ),
            level: 2,
            wikitext: "== {{Mo}}{{R}} Life Barrier Bonder (Hero or Player)==\n<pvxbig>\n[build prof=Monk/Ranger Protection=12+1+3 Divine=3+3 Beast=12][Balthazar's Spirit][Watchful Spirit][Life Barrier][Life Bond][optional][Blessed Signet][Edge of Extinction][Rebirth][/build]\n* If you are bringing a hero, do not bring any other skills that [[gww:Target|Target]].  The hero might walk away from your flag and try to cast it on the tank and grab agro.\n* {{skill pvxicon|Optional}}:\n** {{skill pvxicon|Vital Blessing|16}}\n** {{skill pvxicon|Strength of Honor|8}} (For killing left-overs.)\n** {{skill pvxicon|Heal Party|8}}\n** {{skill pvxicon|Mindbender|10}} (For quicker placement of bonds.)\n</pvxbig>\n\n",
            text: "Life Barrier Bonder (Hero or Player) [build prof=Monk/Ranger Protection=12+1+3 Divine=3+3 Beast=12][Balthazar's Spirit][Watchful Spirit][Life Barrier][Life Bond][optional][Blessed Signet][Edge of Extinction][Rebirth][/build] If you are bringing a hero, do not bring any other skills that Target. The hero might walk away from your flag and try to cast it on the tank and grab agro. Optional Vital Blessing 16 Strength of Honor 8 (For killing left-overs.) Heal Party 8 Mindbender 10 (For quicker placement of bonds.)",
        },
        Section {
            heading: Some(
                "Equipment",
            ),
            level: 3,
            wikitext: "=== Equipment ===\n* Max energy armor\n* High energy staff\n\n",
            text: "Equipment Max energy armor High energy staff",
        },
        Section {
            heading: Some(
                "Usage",
            ),
            level: 3,
            wikitext: "=== Usage ===\n",
            text: "Usage",
        },
        Section {
            heading: Some(
                "Player",
            ),
            level: 4,
            wikitext: "==== Player ====\n* Place all of your bonds on the tank and then cast balthazar's spirit on yourself.  Be sure to use Life Barrier before Life Bond. \n* When the tank pings come into spirit range of the mob and lay down Edge of Extinction.  Do not agro anything or attack any spirits.\n* Pick up loot.\n\n",
            text: "Player Place all of your bonds on the tank and then cast balthazar's spirit on yourself. Be sure to use Life Barrier before Life Bond. When the tank pings come into spirit range of the mob and lay down Edge of Extinction. Do not agro anything or attack any spirits. Pick up loot.",
        },
        Section {
            heading: Some(
                "Hero",
            ),
            level: 4,
            wikitext: "==== Hero ====\n* IMPORTANT: Set hero to [[gww:Hero_behavior#Avoid_Combat|Avoid Combat]]. \n* Cast Balthazar's Spirit on the hero and then cast all bonds on the tank.  Be sure to use Life Barrier before Life Bond.\n* When you walk forward and the hero is on the edge of the map, flag the hero inwards along the wall. (See Videos)\n* After the group is balled, flag the hero slightly closer so it is in spirit range but not agro range and cast Edge of Extinction. \n\n",
            text: "Hero IMPORTANT: Set hero to Avoid Combat. Cast Balthazar's Spirit on the hero and then cast all bonds on the tank. Be sure to use Life Barrier before Life Bond. When you walk forward and the hero is on the edge of the map, flag the hero inwards along the wall. (See Videos) After the group is balled, flag the hero slightly closer so it is in spirit range but not agro range and cast Edge of Extinction.",
        },
        Section {
            heading: Some(
                "Counters",
            ),
            level: 2,
            wikitext: "== Counters ==\n* In Hard mode finding proper placement for the spirit is key due to melee scatter.\n* Player or Hero bonder gets agro.\n* Tank gets KD while casting Shadow Form.\n\n",
            text: "Counters In Hard mode finding proper placement for the spirit is key due to melee scatter. Player or Hero bonder gets agro. Tank gets KD while casting Shadow Form.",
        },
